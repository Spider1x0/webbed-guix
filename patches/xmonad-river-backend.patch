+-- | A rectangle shrunk by a border width on every side, never below 1x1.
+insetBy :: Dimension -> Rectangle -> Rectangle
+insetBy b (Rectangle x y w h) =
+  Rectangle (x + fromIntegral b) (y + fromIntegral b) (shrink w) (shrink h)
+  where shrink d = if d > 2 * b then d - 2 * b else 1
+
+-- | The part of a window's rectangle that lies on its screen, relative to the
+-- window's origin, when that is less than all of it.
+--
+-- 'Nothing' for a window wholly on screen (no clip needed) and for one wholly
+-- off it, which a layout should not have placed and which a zero-sized box
+-- could not express anyway -- river reads zero as "no clipping".
+contentClip :: Rectangle -> Rectangle -> Maybe (Int32, Int32, Int32, Int32)
+contentClip (Rectangle sx sy sw sh) (Rectangle wx wy ww wh)
+  | cw <= 0 || ch <= 0 = Nothing
+  | cw == w && ch == h = Nothing
+  | otherwise = Just (fromIntegral (x0 - x), fromIntegral (y0 - y), fromIntegral cw, fromIntegral ch)
+  where
+    -- Int, because Position + Dimension in Int32 overflows for no good reason.
+    i :: Integral n => n -> Int
+    i = fromIntegral
+    (x, y, w, h) = (i wx, i wy, i ww, i wh)
+    (scx, scy, scw, sch) = (i sx, i sy, i sw, i sh)
+    x0 = max x scx
+    y0 = max y scy
+    cw = min (x + w) (scx + scw) - x0
+    ch = min (y + h) (scy + sch) - y0
+
